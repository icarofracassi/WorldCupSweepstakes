generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  predictions  Prediction[]
  preCupPick   PreCupPick?
}

model Team {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  code           String  @unique
  fifaRanking    Int
  flagEmoji      String?
  isTop14        Boolean @default(false)
  eliminatedPhase String?  // "group"|"r16"|"qf"|"sf"|"3rd"|"final"|"champion"
  shameIndex     Float?
  surpriseIndex  Float?

  matchesAsA     Match[] @relation("TeamA")
  matchesAsB     Match[] @relation("TeamB")
  champPicks     PreCupPick[] @relation("Champion")
  shamePicks     PreCupPick[] @relation("Shame")
  surprisePicks  PreCupPick[] @relation("Surprise")
}

model Match {
  id              Int          @id @default(autoincrement())
  externalId      Int?         @unique  // API-Football fixture_id
  teamA           Team         @relation("TeamA", fields: [teamAId], references: [id])
  teamAId         Int
  teamB           Team         @relation("TeamB", fields: [teamBId], references: [id])
  teamBId         Int
  phase           String       // "group"|"r16"|"qf"|"sf"|"final"
  phaseMultiplier Float
  matchDate       DateTime
  scoreAReal      Int?
  scoreBReal      Int?
  isFinished      Boolean      @default(false)
  predictions     Prediction[]
}

model Prediction {
  id           Int     @id @default(autoincrement())
  user         User    @relation(fields: [userId], references: [id])
  userId       Int
  match        Match   @relation(fields: [matchId], references: [id])
  matchId      Int
  scoreA       Int
  scoreB       Int
  pointsEarned Float   @default(0)
  @@unique([userId, matchId])
}

model PreCupPick {
  id              Int   @id @default(autoincrement())
  user            User  @relation(fields: [userId], references: [id])
  userId          Int   @unique
  champion        Team  @relation("Champion", fields: [championId], references: [id])
  championId      Int
  shameTeam       Team  @relation("Shame", fields: [shameTeamId], references: [id])
  shameTeamId     Int
  surpriseTeam    Team  @relation("Surprise", fields: [surpriseTeamId], references: [id])
  surpriseTeamId  Int
  pointsEarned    Float @default(0)
}